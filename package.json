{
  "name": "forge-crafter-manager",
  "version": "1.0.4",
  "private": true,
  "description": "Локальный менеджер торговых смен крафтеров",
  "author": "Forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbobaCDA/La2TraderTimer-LTT-.git"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.forge.craftermanager",
    "productName": "Forge Crafter Manager",
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "crafter-management.html",
      "assets/icon.ico",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AbobaCDA",
        "repo": "La2TraderTimer-LTT-",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "Forge-Crafter-Manager-Setup-${version}.${ext}",
      "include": "assets/installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "1049",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge — Крафтеры",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Forge-Crafter-Manager-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
